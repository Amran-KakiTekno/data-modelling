{
  "name": "data-modelling",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Master Model Lab - clean-room data reconciliation demo (synthetic data only)",
  "scripts": {
    "dev": "vite --port 4102 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4102 --strictPort",
    "test:e2e": "playwright test",
    "verify:build": "node scripts/verify-build.mjs",
    "verify": "npm run typecheck && npm run test && npm run build && npm run test:e2e && npm run verify:build"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@playwright/test": "^1.50.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.3.0",
    "axe-core": "^4.10.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^5.0.5"
  }
}
